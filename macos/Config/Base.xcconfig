// Identifiers for the app, its File Provider extension and their shared
// app group. To sign a build, set DEVELOPMENT_TEAM (and a bundle prefix of
// your own) in Config/Local.xcconfig, which git ignores.
RUSTFUSE_BUNDLE_PREFIX = dev.rustfuse
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

#include? "Local.xcconfig"

// On macOS an app group is named with the team prefix (empty when unsigned).
RUSTFUSE_APP_GROUP = $(TeamIdentifierPrefix)$(RUSTFUSE_BUNDLE_PREFIX)
